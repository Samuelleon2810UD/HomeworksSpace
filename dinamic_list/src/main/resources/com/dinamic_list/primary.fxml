<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dinamic_list.PrimaryController">
   <children>
      <Label text="Generar Lista" />
      <Button fx:id="generateButton" text="generate list" onAction="#generateList"/>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>



   <children>
      <Label text="Imprimir Lista" />
      <Button fx:id="printButton" text="Print List" onAction="#printLista"/>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   
   <Label fx:id="listLabel" text="" />
</VBox>


